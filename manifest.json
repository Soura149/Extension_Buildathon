{
  "manifest_version": 3,
  "name": "AirWrite",
  "version": "0.1.0",
  "description": "Draw over webpages, annotate viewport snapshots, and save editable notes locally.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AirWrite",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/canvas.js",
        "content/toolbar.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage"]
}
